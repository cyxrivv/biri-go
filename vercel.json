{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/monthly-backup",
      "schedule": "0 0 1 * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "system/**",
      "maxDuration": 300
    }
  }
}
